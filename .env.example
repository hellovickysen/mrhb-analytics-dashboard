# ===========================================
# MRHB Analytics Dashboard — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Also add these to Vercel Environment Variables

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Analytics (GA4) ---
GA4_PROPERTY_ID=123456789
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Search Console ---
# Uses same Google service account as GA4
GSC_SITE_URL=https://mrhb.network

# --- App Store Tracking ---
# No API keys needed — uses public store pages
PLAY_PACKAGE_NAME=sahal.wallet.app
APP_STORE_ID=1602366920

# --- Google Play Console (optional, not required) ---
# Uses same Google service account — only needed for detailed store listing funnel

# --- Short.io ---
SHORTIO_API_KEY=your-shortio-api-key
SHORTIO_DOMAIN=mrhbnetwork.short.gy

# --- Microsoft Clarity ---
CLARITY_API_TOKEN=your-clarity-api-token
CLARITY_PROJECT_ID=your-clarity-project-id

# --- Cron Secret (for Vercel cron jobs) ---
CRON_SECRET=your-random-secret-string
